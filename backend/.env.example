# ─── Banco de dados ───────────────────────────────────────────
# Produção (docker-compose): usar db como hostname
DATABASE_URL=postgresql+psycopg2://pedidobk:pedidobk2026@db:5432/pedidobk
# Dev local (sem docker): usar localhost
# DATABASE_URL=postgresql+psycopg2://pedidobk:pedidobk2026@localhost:5432/pedidobk

# ─── GCS ──────────────────────────────────────────────────────
GCS_BUCKET_NAME=financeiro-00-bucket
GCS_PROJECT_ID=financeiro-489122
GCS_PREFIX=pedidos

# ─── Storage backend ──────────────────────────────────────────
# "gcs" para produção (usa ADC da VM)
# "local" para desenvolvimento sem GCS
STORAGE_BACKEND=gcs
# LOCAL_STORAGE_DIR=/tmp/pedidobk-storage  # só necessário quando STORAGE_BACKEND=local

# ─── App ──────────────────────────────────────────────────────
APP_ENV=production
LOG_LEVEL=INFO
